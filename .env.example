# ==============================================================================
# Umedwar App Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to `.env` and adjust the values according to your environment.
# Note: In Expo, only variables prefixed with EXPO_PUBLIC_ are exposed to JavaScript.

# Election CRM Backend API Base URL
EXPO_PUBLIC_API_BASE_URL=https://election.crm.inficomaiacademy.com

# Candidate Profile Slug / Identifier (matches candidate in Election CRM)
EXPO_PUBLIC_CANDIDATE_ID=sachin-malik

# Expo Application Services (EAS) Project ID (optional, required if using EAS Push service)
EXPO_PUBLIC_EAS_PROJECT_ID=
